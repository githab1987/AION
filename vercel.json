{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/me",
      "destination": "/api/me"
    },
    {
      "source": "/api/v1/ingestion/jobs",
      "destination": "/api/ingestion/jobs"
    },
    {
      "source": "/api/v1/human-gates",
      "destination": "/api/human-gates"
    },
    { "source": "/api/v1/review-items", 
      "destination": "/api/review-items" 
    }
  ]
}
