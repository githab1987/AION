{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/me",
      "destination": "/api/me"
    },
    {
      "source": "/api/v1/ingestion/jobs",
      "destination": "/api/ingestion/jobs"
    },
    {
      "source": "/api/v1/human-gates",
      "destination": "/api/human-gates"
    },
    {
      "source": "/api/v1/investigation",
      "destination": "/api/investigation"
    },
    { "source": "/api/v1/accounting-review", "destination": "/api/accounting-review" },
    { "source": "/api/v1/tax-review", "destination": "/api/tax-review" }
  ]
}
